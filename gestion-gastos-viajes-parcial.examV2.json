      "id": "EXPENSE-MVVM-001",
      "type": "technical",
      "title": "Separación de responsabilidades mediante MVVM",
      "description": "La solución separa la interfaz, el estado de presentación y la lógica de negocio mediante responsabilidades compatibles con MVVM. El cálculo de totales y las validaciones no deben estar implementados exclusivamente dentro de los componentes visuales.",
      "weight": 0.0,
      "source": {
        "file": "criterio_arquitectura_android",
        "section": "Rúbrica global unified-android:v1",
        "reference": "D4. Arquitectura"
      },
      "acceptance_criteria": [
        {
          "id": "EXPENSE-MVVM-001-AC1",
          "description": "Se identifican responsabilidades diferenciadas para interfaz (View), ViewModel y modelo/dominio.",
          "verification": [
